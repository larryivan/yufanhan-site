# Comments (giscus). They default to this repository's Discussions
# (Announcements, set in nuxt.config.ts); set these only to point them elsewhere,
# e.g. in a fork, copying the values from https://giscus.app. Read at build time.
# GISCUS_REPO=
# GISCUS_REPO_ID=
# GISCUS_CATEGORY=
# GISCUS_CATEGORY_ID=

# Visitor statistics (Umami Cloud). The site's own deployments count into its
# Umami website; a copy of the repository counts nothing until it sets
# UMAMI_WEBSITE_ID (set to nothing, counting stops). Only the site's public
# hostname is counted (SITE_URL, or on Vercel the project's production domain),
# plus its www/bare twin for a custom domain, so local development and preview
# deployments are left out. UMAMI_DOMAINS replaces
# that with a comma-separated list of hostnames (set but empty, it counts none).
# Read at build time: set these, not NUXT_PUBLIC_ANALYTICS_*, which prerendered
# pages would not see.
# After adding a custom domain: redeploy; redirect yufan.vercel.app to it in
# Vercel's Domains settings (or list both in UMAMI_DOMAINS); and add
# https://<domain>/api/admin/auth to the GitHub App's callback URLs, so signing
# in to the editor there stops your own visits being counted too.
# UMAMI_WEBSITE_ID=
# UMAMI_DOMAINS=

# Public origin of the site, e.g. https://blog.example.com. Read at build time:
# canonical links, og:url, absolute og:image, the RSS feed, the sitemap and the
# robots.txt Sitemap line all need it. Leave it empty for local development.
# On Vercel it defaults to the project's production domain (its custom domain
# once there is one), so it needs no value there either.
SITE_URL=

# The editor at /admin. Read at run time, so a change needs a redeploy but no
# rebuild. Client ID and secret come from the GitHub App the editor signs in
# with; the session password seals the sign-in cookie: at least 32 random
# characters (openssl rand -base64 32).
NUXT_ADMIN_GITHUB_CLIENT_ID=
NUXT_ADMIN_GITHUB_CLIENT_SECRET=
NUXT_ADMIN_SESSION_PASSWORD=
# On Vercel these come from the deployment itself. Elsewhere: owner/name, and
# the branch the site deploys from.
# NUXT_ADMIN_REPO=larryivan/yufanhan-site
# NUXT_ADMIN_BRANCH=main
# The only GitHub account allowed to sign in. Defaults to the repository owner.
# NUXT_ADMIN_LOGIN=
# `npm run dev` edits the local files unless this is set to github.
# NUXT_ADMIN_STORAGE=github

# Comments (giscus). Enable Discussions on the repository, install the giscus
# GitHub App on it, then copy these from https://giscus.app. Read at build time.
# Until the repo and both ids are set, article pages have no Comments section.
GISCUS_REPO=
GISCUS_REPO_ID=
GISCUS_CATEGORY=
GISCUS_CATEGORY_ID=

# Public origin of the site, e.g. https://blog.example.com. Read at build time:
# canonical links, og:url, absolute og:image, the RSS feed, the sitemap and the
# robots.txt Sitemap line all need it. Leave it empty for local development.
SITE_URL=

# The editor at /admin (see "发帖工具" in the README). Read at run time, so a
# change needs a redeploy but no rebuild. Client ID and secret come from the
# GitHub App the editor signs in with; the session password seals the sign-in
# cookie: at least 32 random characters (openssl rand -base64 32).
NUXT_ADMIN_GITHUB_CLIENT_ID=
NUXT_ADMIN_GITHUB_CLIENT_SECRET=
NUXT_ADMIN_SESSION_PASSWORD=
# On Vercel these come from the deployment itself. Elsewhere: owner/name, and
# the branch the site deploys from.
# NUXT_ADMIN_REPO=larryivan/personal-website
# NUXT_ADMIN_BRANCH=main
# The only GitHub account allowed to sign in. Defaults to the repository owner.
# NUXT_ADMIN_LOGIN=
# `npm run dev` edits the local files unless this is set to github.
# NUXT_ADMIN_STORAGE=github
